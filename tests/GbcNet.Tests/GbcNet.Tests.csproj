<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>GbcNet.Tests</RootNamespace>
    <IsTestProject>true</IsTestProject>
    <IsPublishable>false</IsPublishable>
    <IsPackable>false</IsPackable>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
    <PackageReference Include="Microsoft.Testing.Extensions.HangDump" />
    <PackageReference Include="xunit.v3.mtp-v2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\GbcNet.Core\GbcNet.Core.csproj" />
    <ProjectReference Include="..\..\src\GbcNet.App\GbcNet.App.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content
      Include="Unit\RomTesting\Resources\**\*.gb"
      CopyToOutputDirectory="PreserveNewest"
      TargetPath="RomTesting\Resources\%(RecursiveDir)%(Filename)%(Extension)"
    />
    <Content
      Include="Unit\RomTesting\Resources\**\*.gbc"
      CopyToOutputDirectory="PreserveNewest"
      TargetPath="RomTesting\Resources\%(RecursiveDir)%(Filename)%(Extension)"
    />
    <Content
      Include="Unit\RomTesting\Resources\**\*.dmgshade.bin"
      CopyToOutputDirectory="PreserveNewest"
      TargetPath="RomTesting\Resources\%(RecursiveDir)%(Filename)%(Extension)"
    />
    <Content
      Include="Unit\RomTesting\Resources\**\*.rgb555le.bin"
      CopyToOutputDirectory="PreserveNewest"
      TargetPath="RomTesting\Resources\%(RecursiveDir)%(Filename)%(Extension)"
    />
  </ItemGroup>
</Project>
