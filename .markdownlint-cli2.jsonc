{
  "$schema": "https://raw.githubusercontent.com/DavidAnson/markdownlint-cli2/main/schema/markdownlint-cli2-config-schema.json",
  "gitignore": true,
  "globs": [
    "README.md",
    "docs/**/*.md",
    ".omp/**/*.md"
  ],
  "config": {
    "default": true,
    "MD004": {
      "style": "asterisk"
    },
    "MD013": false,
    "MD025": false,
    "MD026": false,
    "MD033": false
  }
}
