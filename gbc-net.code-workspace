{
  "folders": [
    {
      "name": "Agents",
      "path": ".agents"
    },
    {
      "name": "Source",
      "path": "src"
    },
    {
      "name": "Tests",
      "path": "tests"
    }
  ],
  "settings": {
    "editor.formatOnSave": true,
    "editor.formatOnSaveMode": "file",
    "files.associations": {
      "*.axaml": "xml",
      "*.code-workspace": "jsonc",
      "*.csproj": "xml",
      "*.props": "xml",
      "*.slnx": "xml",
      "**/SKILL.md": "markdown"
    },
    "files.exclude": {
      "**/.idea": true,
      "**/LICENSE": true,
      "**/.config": true,
      "**/nuget.config": true,
      "**/*.DotSettings.*": true,
      "**/TestResults": true,
      "**/artifacts": true
    },
    "[csharp][xml]": {
      "editor.defaultFormatter": "csharpier.csharpier-vscode",
    },
    "[json][jsonc]": {
      "editor.defaultFormatter": "vscode.json-language-features",
    },
    "files.watcherExclude": {
      "**/bin/**": true,
      "**/obj/**": true,
      "**/TestResults/**": true
    },
    "search.exclude": {
      "**/bin/**": true,
      "**/obj/**": true,
      "**/TestResults/**": true
    }
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "install",
        "type": "process",
        "command": "make",
        "args": [
          "install"
        ],
        "options": {
          "cwd": "${workspaceFolder:Source}/.."
        },
        "problemMatcher": []
      },
      {
        "label": "build",
        "type": "process",
        "command": "make",
        "args": [
          "build",
          "CONFIGURATION=Debug"
        ],
        "options": {
          "cwd": "${workspaceFolder:Source}/.."
        },
        "group": {
          "kind": "build",
          "isDefault": true
        },
        "problemMatcher": "$msCompile"
      },
      {
        "label": "build-release",
        "type": "process",
        "command": "make",
        "args": [
          "build",
          "CONFIGURATION=Release"
        ],
        "options": {
          "cwd": "${workspaceFolder:Source}/.."
        },
        "problemMatcher": "$msCompile"
      },
      {
        "label": "lint",
        "type": "process",
        "command": "make",
        "args": [
          "lint"
        ],
        "options": {
          "cwd": "${workspaceFolder:Source}/.."
        },
        "problemMatcher": "$msCompile"
      },
      {
        "label": "test",
        "type": "process",
        "command": "make",
        "args": [
          "test"
        ],
        "options": {
          "cwd": "${workspaceFolder:Source}/.."
        },
        "group": {
          "kind": "test",
          "isDefault": true
        },
        "problemMatcher": "$msCompile"
      }
    ]
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Launch GBC.Net (Debug)",
        "type": "coreclr",
        "request": "launch",
        "program": "${workspaceFolder:Source}/GbcNet.App/bin/Debug/net10.0/GbcNet.dll",
        "cwd": "${workspaceFolder:Source}/..",
        "preLaunchTask": "build",
      },
      {
        "name": "Launch GBC.Net (Release)",
        "type": "coreclr",
        "request": "launch",
        "program": "${workspaceFolder:Source}/GbcNet.App/bin/Release/net10.0/GbcNet.dll",
        "cwd": "${workspaceFolder:Source}/..",
        "preLaunchTask": "build-release",
      }
    ]
  },
  "extensions": {
    "recommendations": [
      "csharpier.csharpier-vscode",
      "EditorConfig.EditorConfig",
      "JetBrains.resharper-code",
      "vscode.json-language-features",
    ]
  }
}
