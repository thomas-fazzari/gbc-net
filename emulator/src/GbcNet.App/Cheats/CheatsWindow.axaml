<Window
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:chrome="clr-namespace:GbcNet.App.Shell.Chrome"
  x:Class="GbcNet.App.Cheats.CheatsWindow"
  Title="Cheats"
  Width="820"
  Height="540"
  MinWidth="700"
  MinHeight="460"
  CanResize="True"
  WindowStartupLocation="CenterOwner"
  Background="{DynamicResource SysCanvasBrush}"
>
  <Window.Styles>
    <Style Selector="TextBlock.page-description">
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="TextBlock.subtitle">
      <Setter Property="FontSize" Value="16" />
    </Style>
    <Style Selector="Border.modal-rail">
      <Setter Property="Padding" Value="8,12" />
    </Style>
    <Style Selector="Border.code-list">
      <Setter Property="Background" Value="{DynamicResource SysSurfaceBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="{DynamicResource RefRadius}" />
    </Style>
    <Style Selector="Border.code-row">
      <Setter Property="BorderBrush" Value="{DynamicResource SysBorderBrush}" />
      <Setter Property="Padding" Value="8" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="*,Auto" ColumnDefinitions="156,*">
    <Border Grid.RowSpan="2" Classes="modal-rail">
      <StackPanel HorizontalAlignment="Stretch" Spacing="6">
        <chrome:SidebarNavButton
          x:Name="GameGenieNavButton"
          Classes="modal-nav selected"
          Icon="IconWand"
          Label="Game Genie"
          Click="ShowGameGeniePage"
          AutomationProperties.Name="Game Genie cheats"
          AutomationProperties.AutomationId="CheatsNavGameGenie"
          AutomationProperties.HelpText="Show Game Genie ROM patch codes"
        />
        <chrome:SidebarNavButton
          x:Name="GameSharkNavButton"
          Classes="modal-nav"
          Icon="IconFish"
          Label="GameShark"
          Click="ShowGameSharkPage"
          AutomationProperties.Name="GameShark cheats"
          AutomationProperties.AutomationId="CheatsNavGameShark"
          AutomationProperties.HelpText="Show GameShark memory write codes"
        />
      </StackPanel>
    </Border>
    <Grid
      Grid.Column="1"
      Margin="20,16,20,12"
      RowDefinitions="Auto,Auto,Auto,*,Auto,Auto"
      MinHeight="0"
    >
      <StackPanel Spacing="2" Margin="0,0,0,12">
        <TextBlock x:Name="PageTitleTextBlock" Classes="subtitle" Text="Game Genie" />
        <TextBlock
          x:Name="PageHelpTextBlock"
          Classes="page-description"
          Text="Codes are checked from top to bottom. The first match wins."
        />
      </StackPanel>

      <Grid Grid.Row="1" RowDefinitions="Auto,Auto" RowSpacing="6">
        <TextBox
          x:Name="NameTextBox"
          Classes="field"
          MaxLength="80"
          PlaceholderText="Name (optional)"
          AutomationProperties.Name="Cheat name (optional)"
          AutomationProperties.HelpText="Optional name for the Game Genie code"
        />
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <TextBox
            x:Name="CodeTextBox"
            Classes="field"
            MaxLength="32"
            PlaceholderText="ABC-DEF or ABC-DEF-GHI"
            TextChanged="ValidateCodeInput"
            AutomationProperties.Name="Game Genie code"
            AutomationProperties.HelpText="Enter a six- or nine-digit Game Genie code"
          />
          <Button
            x:Name="AddButton"
            Grid.Column="1"
            Classes="primary"
            Content="_Add"
            Click="AddCode"
            AutomationProperties.Name="Add Game Genie code"
          />
        </Grid>
      </Grid>

      <StackPanel Grid.Row="2" Spacing="2" Margin="0,4,0,0" MinHeight="16">
        <TextBlock
          x:Name="InputErrorTextBlock"
          Classes="error"
          IsVisible="False"
          AutomationProperties.LiveSetting="Polite"
        />
        <TextBlock
          x:Name="LimitTextBlock"
          Classes="error"
          IsVisible="False"
          AutomationProperties.LiveSetting="Polite"
        />
      </StackPanel>

      <Border Grid.Row="3" Classes="code-list" Margin="0,10,0,0" MinHeight="0">
        <Grid>
          <TextBlock
            x:Name="EmptyStateTextBlock"
            Classes="muted"
            Text="No codes for this game."
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
          />
          <ScrollViewer
            x:Name="EntriesScrollViewer"
            IsVisible="False"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto"
          >
            <StackPanel x:Name="EntriesPanel" />
          </ScrollViewer>
        </Grid>
      </Border>

      <TextBlock
        x:Name="CounterTextBlock"
        Grid.Row="4"
        Classes="muted"
        Margin="0,4,0,0"
        HorizontalAlignment="Right"
        AutomationProperties.Name="Game Genie code count"
      />

      <TextBlock
        x:Name="ApplyErrorTextBlock"
        Grid.Row="5"
        Classes="error"
        Margin="0,4,0,0"
        IsVisible="False"
        AutomationProperties.LiveSetting="Polite"
      />
    </Grid>

    <Border Grid.Row="1" Grid.Column="1" Classes="modal-footer">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock
          x:Name="ApplyingTextBlock"
          Classes="muted"
          IsVisible="False"
          VerticalAlignment="Center"
          AutomationProperties.LiveSetting="Polite"
        />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <Button
            x:Name="CancelButton"
            Classes="secondary"
            Content="_Cancel"
            Click="Cancel"
            AutomationProperties.Name="Cancel cheat changes"
          />
          <Button
            x:Name="ApplyButton"
            Classes="primary"
            Content="_Apply"
            Click="ApplyAsync"
            AutomationProperties.Name="Apply cheat changes"
          />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
