<ResourceDictionary
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
>
  <FontFamily x:Key="SysFontFamily">avares://GbcNet/Assets/Fonts#Instrument Sans</FontFamily>

  <x:Double x:Key="RefSpace1">4</x:Double>
  <x:Double x:Key="RefSpace2">8</x:Double>
  <x:Double x:Key="RefSpace3">12</x:Double>
  <x:Double x:Key="RefSpace4">16</x:Double>
  <x:Double x:Key="RefSpace5">20</x:Double>
  <x:Double x:Key="RefSpace6">24</x:Double>
  <x:Double x:Key="RefSpace8">32</x:Double>
  <x:Double x:Key="RefSpace10">40</x:Double>
  <x:Double x:Key="RefSpace12">48</x:Double>

  <CornerRadius x:Key="RefRadiusSmall">4</CornerRadius>
  <CornerRadius x:Key="RefRadiusMedium">10</CornerRadius>
  <CornerRadius x:Key="RefRadiusLarge">16</CornerRadius>
  <CornerRadius x:Key="RefRadiusPill">999</CornerRadius>

  <x:Double x:Key="RefControlHeightSmall">36</x:Double>
  <x:Double x:Key="RefControlHeight">40</x:Double>
  <x:Double x:Key="RefTargetSize">44</x:Double>

  <x:Double x:Key="RefIconSizeSmall">16</x:Double>
  <x:Double x:Key="RefIconSizeMedium">20</x:Double>
  <x:Double x:Key="RefIconSizeLarge">24</x:Double>
  <x:Double x:Key="RefIconStrokeWidth">2</x:Double>

  <x:Double x:Key="RefFontSizeTitle">28</x:Double>
  <x:Double x:Key="RefLineHeightTitle">34</x:Double>
  <x:Double x:Key="RefFontSizeSubtitle">20</x:Double>
  <x:Double x:Key="RefLineHeightSubtitle">26</x:Double>
  <x:Double x:Key="RefFontSizeBody">14</x:Double>
  <x:Double x:Key="RefLineHeightBody">20</x:Double>
  <x:Double x:Key="RefFontSizeLabel">12</x:Double>
  <x:Double x:Key="RefLineHeightLabel">16</x:Double>

  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <Color x:Key="RefColorCanvas">#F7F7FA</Color>
      <Color x:Key="RefColorSurface">#FFFFFF</Color>
      <Color x:Key="RefColorSurfaceRaised">#EEF0F5</Color>
      <Color x:Key="RefColorText">#17181C</Color>
      <Color x:Key="RefColorTextMuted">#656A76</Color>
      <Color x:Key="RefColorBorder">#D9DBE5</Color>
      <Color x:Key="RefColorPrimary">#7C3AED</Color>
      <Color x:Key="RefColorActive">#4D7C0F</Color>
      <Color x:Key="RefColorDanger">#B42318</Color>
      <Color x:Key="RefColorOnPrimary">#FFFFFF</Color>
      <Color x:Key="RefColorOnActive">#FFFFFF</Color>

      <SolidColorBrush x:Key="SysCanvasBrush" Color="{StaticResource RefColorCanvas}" />
      <SolidColorBrush x:Key="SysSurfaceBrush" Color="{StaticResource RefColorSurface}" />
      <SolidColorBrush
        x:Key="SysSurfaceRaisedBrush"
        Color="{StaticResource RefColorSurfaceRaised}"
      />
      <SolidColorBrush x:Key="SysTextBrush" Color="{StaticResource RefColorText}" />
      <SolidColorBrush x:Key="SysTextMutedBrush" Color="{StaticResource RefColorTextMuted}" />
      <SolidColorBrush x:Key="SysIconBrush" Color="{StaticResource RefColorTextMuted}" />
      <SolidColorBrush x:Key="SysBorderBrush" Color="{StaticResource RefColorBorder}" />
      <SolidColorBrush x:Key="SysPrimaryBrush" Color="{StaticResource RefColorPrimary}" />
      <SolidColorBrush x:Key="SysActiveBrush" Color="{StaticResource RefColorActive}" />
      <SolidColorBrush x:Key="SysDangerBrush" Color="{StaticResource RefColorDanger}" />
      <SolidColorBrush x:Key="SysOnPrimaryBrush" Color="{StaticResource RefColorOnPrimary}" />
      <SolidColorBrush x:Key="SysOnActiveBrush" Color="{StaticResource RefColorOnActive}" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <Color x:Key="RefColorCanvas">#0B0C0F</Color>
      <Color x:Key="RefColorSurface">#121318</Color>
      <Color x:Key="RefColorSurfaceRaised">#1A1C23</Color>
      <Color x:Key="RefColorText">#F4F4F6</Color>
      <Color x:Key="RefColorTextMuted">#A0A4B0</Color>
      <Color x:Key="RefColorBorder">#2D303A</Color>
      <Color x:Key="RefColorPrimary">#9B6CFF</Color>
      <Color x:Key="RefColorActive">#A3E635</Color>
      <Color x:Key="RefColorDanger">#FF7B72</Color>
      <Color x:Key="RefColorOnPrimary">#FFFFFF</Color>
      <Color x:Key="RefColorOnActive">#17181C</Color>

      <SolidColorBrush x:Key="SysCanvasBrush" Color="{StaticResource RefColorCanvas}" />
      <SolidColorBrush x:Key="SysSurfaceBrush" Color="{StaticResource RefColorSurface}" />
      <SolidColorBrush
        x:Key="SysSurfaceRaisedBrush"
        Color="{StaticResource RefColorSurfaceRaised}"
      />
      <SolidColorBrush x:Key="SysTextBrush" Color="{StaticResource RefColorText}" />
      <SolidColorBrush x:Key="SysTextMutedBrush" Color="{StaticResource RefColorTextMuted}" />
      <SolidColorBrush x:Key="SysIconBrush" Color="{StaticResource RefColorTextMuted}" />
      <SolidColorBrush x:Key="SysBorderBrush" Color="{StaticResource RefColorBorder}" />
      <SolidColorBrush x:Key="SysPrimaryBrush" Color="{StaticResource RefColorPrimary}" />
      <SolidColorBrush x:Key="SysActiveBrush" Color="{StaticResource RefColorActive}" />
      <SolidColorBrush x:Key="SysDangerBrush" Color="{StaticResource RefColorDanger}" />
      <SolidColorBrush x:Key="SysOnPrimaryBrush" Color="{StaticResource RefColorOnPrimary}" />
      <SolidColorBrush x:Key="SysOnActiveBrush" Color="{StaticResource RefColorOnActive}" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
