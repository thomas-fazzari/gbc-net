<UserControl
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:converters="using:Avalonia.Data.Converters"
  x:Class="GbcNet.App.Library.LibraryView"
>
  <UserControl.Styles>
    <Style Selector="TextBox.library-search">
      <Setter Property="Height" Value="34" />
      <Setter Property="MinWidth" Value="220" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="Background" Value="{DynamicResource ChromeSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ChromeHairBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource ChromeCornerRadius}" />
      <Setter Property="Foreground" Value="{DynamicResource ChromeTextBrush}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox.library-search:focus">
      <Setter Property="BorderBrush" Value="{DynamicResource ChromeFocusBorderBrush}" />
    </Style>
    <Style Selector="ComboBox.library-filter">
      <Setter Property="Height" Value="34" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="Background" Value="{DynamicResource ChromeSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ChromeHairBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource ChromeTextBrush}" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="ComboBox.library-filter.hardware-filter">
      <Setter Property="MinWidth" Value="120" />
    </Style>
    <Style Selector="ComboBox.library-filter.region-filter">
      <Setter Property="MinWidth" Value="104" />
    </Style>
    <Style Selector="ComboBox.library-filter:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource ChromeMutedBrush}" />
    </Style>
    <Style Selector="ComboBox.library-filter:focus">
      <Setter Property="BorderBrush" Value="{DynamicResource ChromeFocusBorderBrush}" />
    </Style>
    <Style Selector="Button.library-toolbar-button, ToggleButton.library-toolbar-button">
      <Setter Property="Width" Value="34" />
      <Setter Property="Height" Value="34" />
      <Setter Property="MinWidth" Value="34" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource ChromeHairBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource ChromeCornerRadius}" />
      <Setter Property="Foreground" Value="{DynamicResource ChromeMutedBrush}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.library-toolbar-button:pointerover, ToggleButton.library-toolbar-button:pointerover">
      <Setter Property="Background" Value="{DynamicResource ChromeHoverBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ChromeTextBrush}" />
    </Style>
    <Style Selector="ToggleButton.library-toolbar-button:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource ChromeHairBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ChromeTextBrush}" />
    </Style>
    <Style Selector="ToggleButton.library-toolbar-button:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource ChromeHairBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ChromeTextBrush}" />
    </Style>
    <Style Selector="ToggleButton.library-toolbar-button:checked:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource ChromeHairBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ChromeTextBrush}" />
    </Style>
    <Style Selector="Button.library-tile">
      <Setter Property="Width" Value="180" />
      <Setter Property="Height" Value="268" />
      <Setter Property="Margin" Value="6" />
      <Setter Property="Padding" Value="8" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.library-tile:pointerover">
      <Setter Property="Background" Value="{DynamicResource ChromePanelBrush}" />
    </Style>
    <Style Selector="TableView.library-list-row">
      <Setter Property="Foreground" Value="{DynamicResource ChromeStatusBrush}" />
      <Setter Property="Background" Value="{DynamicResource ChromeBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="TableView.library-list-row TableViewColumnHeader">
      <Setter Property="Padding" Value="6,4" />
      <Setter Property="Background" Value="{DynamicResource ChromeBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ChromeSelectedBorderBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="Foreground" Value="{DynamicResource ChromeStatusBrush}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style Selector="Button.library-sort-header">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource ChromeStatusBrush}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style Selector="Button.library-sort-header:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource ChromeTextBrush}" />
    </Style>
    <Style Selector="TableView.library-list-row TableViewRow">
      <Setter Property="MinHeight" Value="64" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="TableView.library-list-row TableViewCell">
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="TableView.library-list-row /template/ ScrollViewer#PART_ScrollViewer /template/ ScrollBar#PART_VerticalScrollBar">
      <Setter Property="Margin" Value="0,22,0,0" />
    </Style>
    <Style Selector="Border.tile-badge">
      <Setter Property="Height" Value="22" />
      <Setter Property="MinWidth" Value="22" />
      <Setter Property="Padding" Value="5,0" />
      <Setter Property="CornerRadius" Value="7" />
    </Style>
    <Style Selector="Button.tile-actions">
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="22" />
      <Setter Property="MinWidth" Value="22" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource ChromeHairBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Foreground" Value="{DynamicResource ChromeStatusBrush}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.tile-actions:pointerover">
      <Setter Property="Background" Value="{DynamicResource ChromeHoverBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ChromeTextBrush}" />
    </Style>
  </UserControl.Styles>

  <Border x:Name="LibraryPageBackground" Background="{DynamicResource ChromeBackgroundBrush}">
    <Grid x:Name="LibraryViewport" Margin="24,18">
      <Grid
        x:Name="LibraryContent"
        MaxWidth="1440"
        Width="{Binding Bounds.Width, ElementName=LibraryViewport}"
        HorizontalAlignment="Center"
        RowDefinitions="Auto,*"
        RowSpacing="16"
      >
        <Border
          Padding="0,0,0,14"
          BorderBrush="{DynamicResource ChromeHairBrush}"
          BorderThickness="0,0,0,1"
        >
          <Grid ColumnSpacing="4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" MinWidth="120" MaxWidth="160" />
              <ColumnDefinition Width="*" MinWidth="104" MaxWidth="144" />
              <ColumnDefinition Width="4*" MinWidth="220" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2" Orientation="Horizontal">
              <Button
                Classes="library-toolbar-button"
                Click="OnOpenRomClick"
                ToolTip.Tip="Open ROM"
                AutomationProperties.Name="Open ROM"
              >
                <PathIcon
                  Width="16"
                  Height="16"
                  Data="{StaticResource IconCollectionsAddRegular}"
                />
              </Button>
              <Border
                Width="1"
                Height="24"
                Margin="4,0"
                Background="{DynamicResource ChromeHairBrush}"
                VerticalAlignment="Center"
              />
              <ToggleButton
                x:Name="GridViewToggle"
                Classes="library-toolbar-button"
                Tag="Grid"
                Click="OnViewModeChanged"
                ToolTip.Tip="Grid view"
                AutomationProperties.Name="Grid view"
              >
                <PathIcon Width="18" Height="18" Data="{StaticResource IconGridRegular}" />
              </ToggleButton>
              <ToggleButton
                x:Name="ListViewToggle"
                Classes="library-toolbar-button"
                Tag="List"
                Click="OnViewModeChanged"
                ToolTip.Tip="List view"
                AutomationProperties.Name="List view"
              >
                <PathIcon Width="16" Height="16" Data="{StaticResource IconAppsListRegular}" />
              </ToggleButton>
            </StackPanel>

            <Border
              Grid.Column="1"
              Width="1"
              Height="24"
              Margin="4,0"
              Background="{DynamicResource ChromeHairBrush}"
              VerticalAlignment="Center"
            />

            <TextBox
              x:Name="LibrarySearchTextBox"
              Grid.Column="4"
              Margin="4,0,0,0"
              Classes="library-search"
              HorizontalAlignment="Stretch"
              PlaceholderText="Search library"
            />

            <ComboBox
              x:Name="HardwareFilter"
              Grid.Column="2"
              Classes="library-filter hardware-filter"
              SelectedIndex="0"
              SelectionChanged="OnHardwareFilterChanged"
              ToolTip.Tip="Hardware"
            >
              <ComboBoxItem Tag="All">Any system</ComboBoxItem>
              <ComboBoxItem Tag="Gb">Game Boy</ComboBoxItem>
              <ComboBoxItem Tag="Gbc">Game Boy Color</ComboBoxItem>
              <ComboBoxItem Tag="Sgb">Super Game Boy</ComboBoxItem>
            </ComboBox>

            <ComboBox
              x:Name="RegionFilter"
              Grid.Column="3"
              Classes="library-filter region-filter"
              SelectedIndex="0"
              SelectionChanged="OnRegionFilterChanged"
              ToolTip.Tip="Region"
            >
              <ComboBoxItem Tag="All">Any region</ComboBoxItem>
              <ComboBoxItem Tag="Japan">Japan</ComboBoxItem>
              <ComboBoxItem Tag="Usa">USA</ComboBoxItem>
              <ComboBoxItem Tag="Europe">Europe</ComboBoxItem>
              <ComboBoxItem Tag="World">World</ComboBoxItem>
              <ComboBoxItem Tag="Other">Other</ComboBoxItem>
            </ComboBox>
          </Grid>
        </Border>

        <Grid Grid.Row="1">
          <ScrollViewer
            x:Name="LibraryScrollViewer"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto"
          >
            <Grid>
              <ItemsControl x:Name="RomGridControl">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:CompileBindings="False">
                    <Button Classes="library-tile" Click="OnRomTileClick">
                      <Grid RowDefinitions="164,48,*">
                        <Border
                          Grid.Row="0"
                          Height="164"
                          Background="{DynamicResource ChromeSurfaceBrush}"
                          ClipToBounds="True"
                          CornerRadius="{DynamicResource ChromeCornerRadius}"
                        >
                          <Grid>
                            <Image
                              Source="{Binding CoverBitmap}"
                              IsVisible="{Binding CoverBitmap, Converter={x:Static converters:ObjectConverters.IsNotNull}}"
                              Stretch="Fill"
                            />
                            <TextBlock
                              Text="ROM"
                              IsVisible="{Binding CoverBitmap, Converter={x:Static converters:ObjectConverters.IsNull}}"
                              Foreground="{DynamicResource ChromeMutedBrush}"
                              FontSize="26"
                              FontWeight="SemiBold"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                            />
                          </Grid>
                        </Border>
                        <TextBlock
                          Grid.Row="1"
                          Margin="0,8,0,0"
                          Text="{Binding UserFriendlyTitle}"
                          Foreground="{DynamicResource ChromeTextBrush}"
                          FontSize="13"
                          FontWeight="Medium"
                          MaxLines="2"
                          TextTrimming="WordEllipsis"
                          TextWrapping="Wrap"
                          VerticalAlignment="Top"
                        />
                        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,28" ColumnSpacing="2">
                          <StackPanel
                            Spacing="4"
                            Orientation="Horizontal"
                            VerticalAlignment="Bottom"
                          >
                            <PathIcon
                              Width="12"
                              Height="12"
                              Data="{StaticResource IconTimerRegular}"
                              Foreground="{DynamicResource ChromeMutedBrush}"
                            />
                            <TextBlock
                              Text="{Binding PlayTimeText}"
                              Foreground="{DynamicResource ChromeMutedBrush}"
                              FontSize="11"
                              VerticalAlignment="Center"
                            />
                          </StackPanel>
                          <Border
                            Grid.Column="1"
                            Classes="badge tile-badge"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                          >
                            <TextBlock
                              Text="{Binding HardwareText}"
                              Classes="badge-text"
                              VerticalAlignment="Center"
                            />
                          </Border>
                          <Button
                            Grid.Column="2"
                            Classes="tile-actions"
                            VerticalAlignment="Bottom"
                            Loaded="OnTileActionsButtonLoaded"
                            Click="OnTileActionsButtonClick"
                            AutomationProperties.Name="ROM actions"
                          >
                            <PathIcon Width="12" Height="12" Data="{StaticResource IconSettings}" />
                          </Button>
                        </Grid>
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Grid>
          </ScrollViewer>
          <TableView
            x:Name="RomTableView"
            IsVisible="False"
            Classes="library-list-row"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            SelectionChanged="OnRomTileClick"
          >
            <TableView.Resources>
              <StaticResource
                x:Key="SystemControlBackgroundChromeMediumBrush"
                ResourceKey="ChromeBackgroundBrush"
              />
              <SolidColorBrush
                x:Key="TableViewColumnHeaderSeparatorBackground"
                Color="Transparent"
              />
              <StaticResource x:Key="TableViewRowBackground" ResourceKey="ChromeBackgroundBrush" />
              <StaticResource
                x:Key="TableViewRowBackgroundPointerOver"
                ResourceKey="ChromePanelBrush"
              />
              <StaticResource
                x:Key="TableViewRowBackgroundPressed"
                ResourceKey="ChromePanelBrush"
              />
              <Thickness x:Key="TableViewRowPadding">0</Thickness>
              <Thickness x:Key="TableViewCellPadding">6,4</Thickness>
            </TableView.Resources>
            <TableView.Columns>
              <TableViewColumn
                Header="Cover"
                Width="60"
                CanUserResize="False"
                HorizontalContentAlignment="Center"
              >
                <TableViewColumn.CellTemplate>
                  <DataTemplate x:CompileBindings="False">
                    <Border
                      Width="48"
                      Height="48"
                      Background="{DynamicResource ChromeSurfaceBrush}"
                      ClipToBounds="True"
                      CornerRadius="{DynamicResource ChromeCornerRadius}"
                    >
                      <Grid>
                        <Image
                          Source="{Binding CoverBitmap}"
                          IsVisible="{Binding CoverBitmap, Converter={x:Static converters:ObjectConverters.IsNotNull}}"
                          Stretch="Fill"
                        />
                        <TextBlock
                          Text="ROM"
                          IsVisible="{Binding CoverBitmap, Converter={x:Static converters:ObjectConverters.IsNull}}"
                          Foreground="{DynamicResource ChromeMutedBrush}"
                          FontSize="10"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                        />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </TableViewColumn.CellTemplate>
              </TableViewColumn>
              <TableViewColumn Header="ROM" Width="*" CanUserResize="False">
                <TableViewColumn.HeaderTemplate>
                  <DataTemplate x:CompileBindings="False">
                    <Button
                      Classes="library-sort-header"
                      Tag="Title"
                      Click="OnTableSortClick"
                      ToolTip.Tip="Sort by title"
                    >
                      <StackPanel Spacing="8" Orientation="Horizontal">
                        <TextBlock Text="ROM" />
                        <PathIcon
                          Width="10"
                          Height="10"
                          Data="{StaticResource IconSortDesc}"
                          IsVisible="{Binding $parent[UserControl].IsTitleSortAscending}"
                        />
                        <PathIcon
                          Width="10"
                          Height="10"
                          Data="{StaticResource IconSortAsc}"
                          IsVisible="{Binding $parent[UserControl].IsTitleSortDescending}"
                        />
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </TableViewColumn.HeaderTemplate>
                <TableViewColumn.CellTemplate>
                  <DataTemplate x:CompileBindings="False">
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                      <TextBlock
                        Text="{Binding UserFriendlyTitle}"
                        Foreground="{DynamicResource ChromeTextBrush}"
                        FontSize="13"
                        FontWeight="Medium"
                        TextTrimming="CharacterEllipsis"
                        MaxLines="1"
                        TextWrapping="NoWrap"
                      />
                      <TextBlock
                        Text="{Binding CartridgeTitle}"
                        IsVisible="{Binding HasCartridgeTitle}"
                        Foreground="{DynamicResource ChromeMutedBrush}"
                        FontSize="11"
                        TextTrimming="CharacterEllipsis"
                        MaxLines="1"
                        TextWrapping="NoWrap"
                      />
                    </StackPanel>
                  </DataTemplate>
                </TableViewColumn.CellTemplate>
              </TableViewColumn>
              <TableViewColumn
                Header="System"
                Width="96"
                Binding="{ReflectionBinding HardwareText}"
              />
              <TableViewColumn Header="Region" Width="108">
                <TableViewColumn.CellTemplate>
                  <DataTemplate x:CompileBindings="False">
                    <StackPanel Spacing="4" Orientation="Horizontal" VerticalAlignment="Center">
                      <Border
                        Width="21"
                        Height="14"
                        IsVisible="{Binding HasJapan}"
                        ClipToBounds="True"
                        CornerRadius="2"
                      >
                        <Image Source="avares://GbcNet/Assets/Images/japan.png" Stretch="Fill" />
                      </Border>
                      <Border
                        Width="21"
                        Height="14"
                        IsVisible="{Binding HasUsa}"
                        ClipToBounds="True"
                        CornerRadius="2"
                      >
                        <Image Source="avares://GbcNet/Assets/Images/usa.png" Stretch="Fill" />
                      </Border>
                      <Border
                        Width="21"
                        Height="14"
                        IsVisible="{Binding HasEurope}"
                        ClipToBounds="True"
                        CornerRadius="2"
                      >
                        <Image Source="avares://GbcNet/Assets/Images/europe.png" Stretch="Fill" />
                      </Border>
                      <Border
                        Width="21"
                        Height="14"
                        IsVisible="{Binding HasWorld}"
                        ClipToBounds="True"
                        CornerRadius="2"
                      >
                        <Image Source="avares://GbcNet/Assets/Images/world.png" Stretch="Fill" />
                      </Border>
                      <TextBlock
                        IsVisible="{Binding HasOther}"
                        Text="Other"
                        Foreground="{DynamicResource ChromeStatusBrush}"
                        FontSize="12"
                        VerticalAlignment="Center"
                      />
                    </StackPanel>
                  </DataTemplate>
                </TableViewColumn.CellTemplate>
              </TableViewColumn>
              <TableViewColumn
                Header="Time Played"
                Width="112"
                Binding="{ReflectionBinding PlayTimeText}"
              >
                <TableViewColumn.HeaderTemplate>
                  <DataTemplate x:CompileBindings="False">
                    <Button
                      Classes="library-sort-header"
                      Tag="MostTimePlayed"
                      Click="OnTableSortClick"
                      ToolTip.Tip="Sort by time played"
                    >
                      <StackPanel Spacing="8" Orientation="Horizontal">
                        <TextBlock Text="Time Played" />
                        <PathIcon
                          Width="10"
                          Height="10"
                          Data="{StaticResource IconSortDesc}"
                          IsVisible="{Binding $parent[UserControl].IsTimePlayedSortAscending}"
                        />
                        <PathIcon
                          Width="10"
                          Height="10"
                          Data="{StaticResource IconSortAsc}"
                          IsVisible="{Binding $parent[UserControl].IsTimePlayedSortDescending}"
                        />
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </TableViewColumn.HeaderTemplate>
              </TableViewColumn>
              <TableViewColumn
                Header="Plays"
                Width="80"
                Binding="{ReflectionBinding PlayCountText}"
              >
                <TableViewColumn.HeaderTemplate>
                  <DataTemplate x:CompileBindings="False">
                    <Button
                      Classes="library-sort-header"
                      Tag="MostPlayed"
                      Click="OnTableSortClick"
                      ToolTip.Tip="Sort by plays"
                    >
                      <StackPanel Spacing="8" Orientation="Horizontal">
                        <TextBlock Text="Plays" />
                        <PathIcon
                          Width="10"
                          Height="10"
                          Data="{StaticResource IconSortDesc}"
                          IsVisible="{Binding $parent[UserControl].IsPlaysSortAscending}"
                        />
                        <PathIcon
                          Width="10"
                          Height="10"
                          Data="{StaticResource IconSortAsc}"
                          IsVisible="{Binding $parent[UserControl].IsPlaysSortDescending}"
                        />
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </TableViewColumn.HeaderTemplate>
              </TableViewColumn>
              <TableViewColumn
                Header="Last played"
                Width="120"
                Binding="{ReflectionBinding LastPlayedText}"
              >
                <TableViewColumn.HeaderTemplate>
                  <DataTemplate x:CompileBindings="False">
                    <Button
                      Classes="library-sort-header"
                      Tag="LastOpened"
                      Click="OnTableSortClick"
                      ToolTip.Tip="Sort by last played"
                    >
                      <StackPanel Spacing="8" Orientation="Horizontal">
                        <TextBlock Text="Last played" />
                        <PathIcon
                          Width="10"
                          Height="10"
                          Data="{StaticResource IconSortDesc}"
                          IsVisible="{Binding $parent[UserControl].IsLastPlayedSortAscending}"
                        />
                        <PathIcon
                          Width="10"
                          Height="10"
                          Data="{StaticResource IconSortAsc}"
                          IsVisible="{Binding $parent[UserControl].IsLastPlayedSortDescending}"
                        />
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </TableViewColumn.HeaderTemplate>
              </TableViewColumn>
              <TableViewColumn
                Header="Actions"
                Width="64"
                CanUserResize="False"
                HorizontalContentAlignment="Left"
              >
                <TableViewColumn.CellTemplate>
                  <DataTemplate x:CompileBindings="False">
                    <Button
                      Classes="tile-actions"
                      HorizontalAlignment="Left"
                      Loaded="OnTileActionsButtonLoaded"
                      Click="OnTileActionsButtonClick"
                      AutomationProperties.Name="ROM actions"
                    >
                      <PathIcon Width="12" Height="12" Data="{StaticResource IconSettings}" />
                    </Button>
                  </DataTemplate>
                </TableViewColumn.CellTemplate>
              </TableViewColumn>
            </TableView.Columns>
          </TableView>

          <Grid x:Name="EmptyState">
            <StackPanel
              MaxWidth="320"
              Spacing="8"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
            >
              <TextBlock
                x:Name="EmptyStateText"
                FontSize="16"
                FontWeight="SemiBold"
                Foreground="{DynamicResource ChromeTextBrush}"
                TextAlignment="Center"
              />
              <TextBlock
                x:Name="EmptyStateDescription"
                FontSize="12"
                Foreground="{DynamicResource ChromeMutedBrush}"
                TextAlignment="Center"
                TextWrapping="Wrap"
              />
              <Button
                x:Name="ClearFiltersButton"
                Classes="chrome-button"
                Margin="0,4,0,0"
                Content="Clear filters"
                Click="ClearFilters"
                HorizontalAlignment="Center"
              />
            </StackPanel>
          </Grid>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</UserControl>
