<Application
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  x:Class="GbcNet.App.GbcNetApplication"
  Name="GbcNet"
  RequestedThemeVariant="Dark"
>
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://GbcNet/Shell/Styling/DesignTokens.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <SimpleTheme />
    <StyleInclude Source="avares://GbcNet/Shell/Styling/ComponentStyles.axaml" />
  </Application.Styles>
</Application>
